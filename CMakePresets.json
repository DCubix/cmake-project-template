{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "windows-msvc",
            "displayName": "Windows x64 (MSVC)",
            "description": "Builds with the Visual Studio 17 2022 generator targeting x64",
            "inherits": "base",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-ninja",
            "displayName": "Windows x64 Ninja (MSVC)",
            "description": "Builds with Ninja using the MSVC toolchain",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-gcc",
            "displayName": "Linux GCC",
            "description": "Builds with Ninja using GCC",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-clang",
            "displayName": "Linux Clang",
            "description": "Builds with Ninja using Clang",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "macos-clang",
            "displayName": "macOS AppleClang",
            "description": "Builds with Ninja using AppleClang",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "description": "Debug build (no optimisations, full symbols) — inherits the host platform preset",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-msvc",
            "displayName": "Windows MSVC Release",
            "configurePreset": "windows-msvc",
            "configuration": "Release"
        },
        {
            "name": "windows-ninja",
            "displayName": "Windows Ninja Release",
            "configurePreset": "windows-ninja"
        },
        {
            "name": "linux-gcc",
            "displayName": "Linux GCC Release",
            "configurePreset": "linux-gcc"
        },
        {
            "name": "linux-clang",
            "displayName": "Linux Clang Release",
            "configurePreset": "linux-clang"
        },
        {
            "name": "macos-clang",
            "displayName": "macOS Clang Release",
            "configurePreset": "macos-clang"
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "configurePreset": "debug"
        }
    ]
}
